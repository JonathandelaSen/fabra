{
  "name": "fabra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "dev:android": "node scripts/dev-emulator.mjs android",
    "dev:ios": "node scripts/dev-emulator.mjs ios",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:string-contracts": "node scripts/lint-string-contracts.mjs",
    "test:eslint-rules": "node --test eslint-rules/*.test.mjs",
    "test": "npm run test:frontend && npm run test:backend && npm run test:e2e:local",
    "agent:check": "node scripts/agent-check.mjs",
    "api:check": "node scripts/verify-api-controllers.mjs",
    "shared-components:check": "node scripts/verify-shared-component-tones.mjs",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:backend": "node scripts/test-backend.mjs",
    "ddd:check": "node scripts/verify-ddd.mjs",
    "test:e2e:local": "node scripts/e2e/run-local.mjs",
    "test:e2e:ui": "node scripts/e2e/run-local.mjs --ui",
    "test:bundle": "npm run build && node scripts/verify-pdf-parser-bundle.mjs",
    "parser:dev": "docker compose --env-file .env.local up pdf-parser",
    "supabase:start": "supabase start",
    "supabase:seed-agent": "npx tsx --tsconfig tsconfig.scripts.json scripts/seed-synthetic-data.ts",
    "supabase:stop": "supabase stop",
    "supabase:sync-email-template": "node scripts/sync-supabase-email-template.mjs",
    "supabase:preview-email": "node scripts/preview-email.mjs",
    "supabase:migrate:local": "supabase migration up",
    "supabase:migrate:prod": "supabase db push"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@google/genai": "^1.50.1",
    "@napi-rs/canvas": "^0.1.100",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.57.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.100.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jsonrepair": "^3.14.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "next-intl": "^4.12.0",
    "ollama": "^0.6.3",
    "openai": "^6.39.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "supabase": "^2.95.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
